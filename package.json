{
  "name": "aetheris",
  "version": "0.8.1",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @aetheris/database generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "node --test \"scripts/*.test.mjs\" && turbo test",
    "test:e2e": "playwright test",
    "check": "node --test \"scripts/*.test.mjs\" && turbo typecheck lint test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "db:generate": "pnpm --filter @aetheris/database generate",
    "db:migrate": "pnpm --filter @aetheris/database migrate:dev",
    "db:push": "pnpm --filter @aetheris/database db:push",
    "db:studio": "pnpm --filter @aetheris/database studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "oxfmt": "^0.73.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.4"
}
