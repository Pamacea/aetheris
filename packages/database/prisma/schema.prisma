// Aetheris — Schéma Prisma (local-first PostgreSQL)
// Voir ROADMAP.md § Modèle de Données

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  apiKeys      ApiKey[]
  campaigns    CampaignMember[]
  novels       Novel[]
  novelCollaborations NovelCollaborator[]
  gameSystems  GameSystem[]
  entityAssignments EntityAssignee[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Clé API personnelle : le token clair n'est jamais stocké, seul son sha256.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  hashedKey  String
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Campagnes ─────────────────────────

model Campaign {
  id                String           @id @default(uuid())
  title             String
  description       String?          // pitch de campagne (assistant de création)
  visibility        String           @default("private") // private | public
  coverImage        String?          // image de couverture (URL ou data-URI)
  logo              String?          // logo de campagne (URL ou data-URI)
  theme             String           @default("pandemonium") // thème natif ou "custom"
  customThemeScript String?          // JS de thème importé par l'utilisateur
  gameSystem        String           @default("custom") // id de preset ou "custom" (legacy)
  gameSystemId      String?          // système choisi dans le hub (preset ou homebrew)
  gameSystemRef     GameSystem?      @relation(fields: [gameSystemId], references: [id], onDelete: SetNull)
  customScript      String?          // JS custom injecté (bac à sable)
  customStyles      String?          // CSS custom injecté
  enabledPlugins    String[]         @default(["lore-wiki"])
  inviteCode        String           @unique @default(uuid())
  entities       Entity[]
  templates      JsonTemplate[]
  members        CampaignMember[]
  chatMessages   ChatMessage[]
  scene          VttScene?
  encounter      CampaignEncounter?
  journalEntries JournalEntry[]
  playlists      AmbiancePlaylist[]
  ambiance       CampaignAmbiance?
  playerChoices  PlayerChoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CampaignMember {
  id         String   @id @default(uuid())
  role       String   @default("PLAYER") // GM | PLAYER
  permissions Json? // grants granulaires — { view: { [pluginId]: false } } = refus explicite
  userId     String
  campaignId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
}

model JsonTemplate {
  id         String   @id @default(uuid())
  name       String
  category   String? // ex. « Encyclopédie » — regroupe les templates côté wiki
  schema     Json // structure des champs (validée par Zod)
  customCss  String? // style propre au modèle, sanitisé serveur, injecté au rendu
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Entity {
  id          String   @id @default(uuid())
  title       String
  type        String // id/nom du template, ou "note" pour une note wiki libre
  data        Json // données saisies selon le template
  contentHtml String? // corps de la note (lore)
  folder      String? // dossier dans le panneau wiki (null = racine)
  gmOnly      Boolean  @default(false) // note secrète : invisible des joueurs
  shareSlug   String? @unique // wiki partageable : slug public (null = non partagé)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignees   EntityAssignee[]
  versions    EntityVersion[]
  linksFrom   EntityLink[] @relation("LinkFrom")
  linksTo     EntityLink[] @relation("LinkTo")

  @@index([campaignId])
}

/// Joueurs assignés à une fiche (0..n). Aucun assigné = lecture seule joueur.
model EntityAssignee {
  entityId String
  userId   String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entityId, userId])
  @@index([userId])
}

// Arêtes du graphe de relations (personnages, lieux, factions…)
model EntityLink {
  id         String   @id @default(uuid())
  label      String? // ex. « allié de », « réside à »
  fromEntityId String
  toEntityId   String
  fromEntity   Entity   @relation("LinkFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     Entity   @relation("LinkTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])
}

// ───────────────────────── Choix joueurs (Amsel-style) ───────────────

model PlayerChoice {
  id          String   @id @default(uuid())
  prompt      String // question lancée aux joueurs
  options     Json     // string[] — libellés des options
  status      String   @default("open") // open | resolved
  resolvedOption Int? // index de l'option retenue quand resolved
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  votes       ChoiceVote[]
  createdAt   DateTime @default(now())

  @@index([campaignId, createdAt])
}

model ChoiceVote {
  id          String       @id @default(uuid())
  optionIndex Int
  comment     String?
  choiceId    String
  userId      String
  choice      PlayerChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@unique([choiceId, userId]) // un vote par joueur
  @@index([choiceId])
}

model EntityVersion {
  id          String   @id @default(uuid())
  contentHtml String
  createdAt   DateTime @default(now())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

// ───────────────────────── Temps réel (Phase 6) ─────────────────────

model ChatMessage {
  id          String   @id @default(uuid())
  campaignId  String
  authorId    String? // null si l'auteur a quitté la campagne
  authorName  String
  content     String
  sentAt      DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sentAt])
}

model VttScene {
  id         String   @id @default(uuid())
  campaignId String   @unique
  state      Json // tokens, walls, grid, mapUrl, fog (SceneState de @aetheris/shared)
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Module Combat (Phase 8) ──────────────────

model CampaignEncounter {
  id         String   @id @default(uuid())
  campaignId String   @unique
  state      Json // combatants, activeIndex, round, active (CombatState de @aetheris/shared)
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Module Journal (Phase 8) ─────────────────

model JournalEntry {
  id          String   @id @default(uuid())
  title       String
  content     String   @default("")
  imageUrl    String?
  shared      Boolean  @default(false) // false = brouillon MJ seul
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId, createdAt])
}

// ───────────────────────── Module Ambiance (Phase 8) ────────────────

model AmbiancePlaylist {
  id         String   @id @default(uuid())
  name       String
  tracks     Json     @default("[]") // AudioTrack[] de @aetheris/shared
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model CampaignAmbiance {
  id         String   @id @default(uuid())
  campaignId String   @unique
  state      Json     @default("{}") // AmbianceState de @aetheris/shared (lecture en cours)
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Systèmes de jeu ─────────────────────────

model GameSystem {
  id               String   @id @default(uuid())
  name             String
  description      String?
  genre            String   @default("autre") // fantasy | horreur | sci-fi | narratif | autre
  isPreset         Boolean  @default(false) // true = preset officiel (ownerId null)
  ownerId          String? // propriétaire d'un système homebrew (null pour un preset)
  defaultTemplates Json     @default("[]") // SystemTemplateSeed[] (nom, catégorie, TemplateSchema)
  defaultAssets    Json     @default("[]") // SystemAsset[] (sorts, compétences, traits…)
  defaultLore      Json     @default("[]") // SystemLoreNote[] (notes seedées à la création)
  defaultHandouts  Json     @default("[]") // SystemHandout[] (handouts de journal seedés)
  isPublic         Boolean  @default(false) // preset personnel sélectionnable par tous
  publishedAt      DateTime? // passage en public (null = privé)
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
}

// ───────────────────────── Romans (module d'écriture) ─────────────────────────

model Novel {
  id            String    @id @default(uuid())
  title         String
  synopsis      String?
  status        String    @default("draft") // draft | writing | published
  coverImage    String?
  genre         String?
  tags          String[]  @default([])
  shareToken    String?   @unique
  shareMode     String? // read | review | edit — null si partage désactivé
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  collaborators NovelCollaborator[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authorId])
  @@index([status, updatedAt])
  @@index([genre])
}

model Chapter {
  id          String    @id @default(uuid())
  title       String
  position    Int
  content     Json? // document TipTap (JSON structuré)
  wordCount   Int       @default(0)
  status      String    @default("draft") // draft | review | published
  publishedAt DateTime?
  novelId     String
  novel       Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([novelId])
}

model NovelCollaborator {
  novelId   String
  userId    String
  role      String   @default("editor") // editor uniquement aujourd'hui
  createdAt DateTime @default(now())
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([novelId, userId])
  @@index([userId])
}
